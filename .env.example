# Copy to .env and fill in. Never commit .env.
# See docs/development.md for setup.

# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Required for command deployment: application (client) ID
DISCORD_CLIENT_ID=
# Optional: guild ID for fast guild-command deploys during development.
# If empty, deploy-commands registers global commands (1h propagation).
DISCORD_GUILD_ID=

# SQLite file path (default: ./data/snipebot.db)
DATABASE_PATH=./data/snipebot.db
# Local media storage dir (default: ./data/media)
MEDIA_STORAGE_PATH=./data/media
# Max attachment bytes to archive (default: 100000000)
MEDIA_MAX_BYTES=100000000
# Archive DM snapshots too (default: false — privacy by design).
# Must be exactly 'true' to enable; anything else means off.
ARCHIVE_DMS=false

NODE_ENV=development
LOG_LEVEL=info
